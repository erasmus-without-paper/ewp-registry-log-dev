                    </server-auth-methods>
                </http-security>
                <url>https://unict-ewp-dev.gomp.it/api/ewp/echo/v2</url>
            </echo>
        </apis-implemented>
        <institutions-covered>
            <hei
                xmlns="https://github.com/erasmus-without-paper/ewp-specs-api-registry/tree/stable-v1"
                id="unict.it"
            >
                <other-id type="erasmus">I  CATANIA01</other-id>
                <name xml:lang="en">University of Catania</name>
                <name xml:lang="it">Universita' degli studi di Catania</name>
            </hei>
        </institutions-covered>
        <client-credentials-in-use>
            <rsa-public-key></rsa-public-key>
        </client-credentials-in-use>
        <server-credentials-in-use>
            <rsa-public-key></rsa-public-key>
